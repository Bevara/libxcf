{
    "name": "libxcf",
    "version": "1.0.1",
    "description": "GIMP (XCF) decoder",
    "filters":["xcfdec"],
    "help": "This filter decodes GIMP XCF documents using the core of xcftools, compositing the visible layers onto the canvas.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libxcf.accessor",
    "filter_source":{
        "xcfdec" : "dec_xcf.c"
    },
    "extension":{
      "xcf" : "img"
    },
    "using": ["solver_minimal_1", "solver_1"],
    "patents": {
        "status": "royalty-free",
        "note": "GIMP XCF",
        "checked": "2026-10-16"
    }
}
